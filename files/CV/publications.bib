%% BibTeX entries for all of my papers. Used by BOTH:
%%   - the CV (biblatex/Biber), and
%%   - my website 
%%
%% Website-only fields. BibTeX/Biber ignore fields they don't know, so
%% these don't change the CV:
%%   code       = {URL}    "Code" button
%%   slides     = {path}   "Slides" button (path in the website repo, or URL)
%%   poster     = {path}   "Poster" button
%%   data       = {URL}    "Data" button
%%   supplement = {URL}    "Supplement" button
%%   preprint   = {URL}    "Preprint" button for non-arXiv preprints
%%                         (arXiv preprints: use eprint/archiveprefix instead)
%%   award      = {text}   Award line under the entry
%%   status     = {...}    Override the automatic Preprint/Peer-reviewed
%%                         grouping: preprint | published
%%
%% Highlighting my name: author+an = {N=highlight}, where N is my position
%% in the author list. The CV bolds it via cvstyle.sty; the website script
%% also bolds it (and bolds my name even without the annotation).


@article{HeatonJohnson2026,
	author = {Heaton, Matthew J. and Johnson, Jacob A.},
	author+an = {2=highlight},
	title = {Minibatch {Markov} Chain {Monte} {Carlo} Algorithms for Fitting {Gaussian} Processes},
	journal = {Bayesian Analysis},
	publisher = {International Society for Bayesian Analysis},
	volume = {21},
	number = {1},
	pages = {21--43},
	month = {3},
	year = {2026},
	doi = {10.1214/24-BA1459},
	url = {https://doi.org/10.1214/24-BA1459},
	eprint = {2310.17766},
	archiveprefix = {arXiv},
	code = {https://github.com/jajohnsonstats/MiniBatchGPs},
	poster = {files/presentations/MiniBatchGPs/MiniBatchGP_Poster.pdf},
	slides = {files/presentations/MiniBatchGPs/BYU_overview_slides.pdf},
	keywords = {high dimensional, spatial statistics, stationary process},
	abstract = {Gaussian processes (GPs) are a highly flexible, nonparametric statistical model that are commonly used to fit nonlinear relationships or account for correlation between observations. However, the computational load of fitting a Gaussian process is $\mathcal{O}(n^3)$ making them infeasible for use on large datasets. To make GPs more feasible for large datasets, this research focuses on the use of minibatching to estimate GP parameters. Specifically, we outline both approximate and exact minibatch Markov chain Monte Carlo algorithms that substantially reduce the computation of fitting a GP by only considering small subsets of the data at a time. We demonstrate and compare this methodology using various simulations and real datasets.}
}


@article{Johnson2026-ae,
	author = {Johnson, Jacob A. and Heaton, Matthew J. and Christensen, William F. and Warr, Lynsie R. and Rupper, Summer B.},
	author+an = {1=highlight},
	title = {Fusing Climate Data Products Using a Spatially Varying Autoencoder},
	journal = {Journal of Agricultural, Biological and Environmental Statistics},
	volume = {31},
	number = {2},
	pages = {273--286},
	month = {6},
	year = {2026},
	issn = {1537-2693},
	doi = {10.1007/s13253-024-00657-3},
	url = {https://doi.org/10.1007/s13253-024-00657-3},
	eprint = {2403.07822},
	archiveprefix = {arXiv},
	code = {https://github.com/jajohnsonstats/Weather-Autoencoder},
	poster = {files/presentations/AE/Autoencoder_Poster.pdf},
	slides = {files/presentations/AE/JSM2024_JacobJohnson.pptx},
	award = {Winner, 2024 ASA Section on Statistics and the Environment Student Paper Competition},
	abstract = {Autoencoders are powerful machine learning models used to compress information from multiple data sources. However, autoencoders, like all artificial neural networks, are often unidentifiable and uninterpretable. This research focuses on creating an identifiable and interpretable autoencoder that can be used to meld and combine climate data products. The proposed autoencoder utilizes a Bayesian statistical framework, allowing for probabilistic interpretations while also varying spatially to capture useful spatial patterns across the various data products. Constraints are placed on the autoencoder as it learns patterns in the data, creating an interpretable consensus that includes the important features from each input. We demonstrate the utility of the autoencoder by combining information from multiple precipitation products in High Mountain Asia.}
}
